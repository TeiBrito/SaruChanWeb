---
// "El estudio" as a character-select screen: Tei Brito is the one and only player.
// Stats are a joke; tweak them freely.
const stats = [
  { label: 'Café', value: 95 },
  { label: 'Multiclase', value: 100 },
  { label: 'Paciencia con los bugs', value: 37 },
];
---
<section class="sec sec--cream" id="estudio" aria-labelledby="estudio-title">
  <div class="wrap studio">
    <div class="studio__card" data-reveal>
      <p class="studio__p1" aria-hidden="true">Player 1</p>
      <div class="studio__avatar">
        <img src="/team/tei.jpg" alt="Retrato ilustrado de Tei Brito, con gorro, barba y camisa roja" width="800" height="800" loading="lazy" />
      </div>
      <p class="studio__name">Tei Brito</p>
      <p class="studio__class">Clase: Estudio de una sola persona</p>
      <p class="studio__buddy">
        <img src="/brand/mono-negativo.svg" alt="" width="1480" height="1050" loading="lazy" />
        Compañero: Saru
      </p>
      <dl class="stats">
        {stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>
              <span class="stat__bar" style={`--v:${s.value}%`}><span class="sr-only">{s.value} de 100</span></span>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="studio__text">
      <p class="stage">Stage 03</p>
      <h2 class="title" id="estudio-title">El estudio</h2>
      <p>
        <strong>SaruChan Videogames</strong> es un estudio independiente de una sola persona: Tei Brito. Diseño,
        código, arte y alguna que otra noche sin dormir salen de las mismas manos. Juegos con personalidad,
        trazo a mano y detalles que te sacan una sonrisa.
      </p>
      <p>
        Saru, el mono con gafas, es la mascota del estudio y el encargado oficial de probarlo todo y, de vez
        en cuando, romper algo. Así es como se aprende.
      </p>
      <p class="studio__kanji"><span lang="ja">猿</span> <span>saru: «mono» en japonés, y la forma cariñosa en la que Tei Brito llama a su hijo</span></p>
    </div>
  </div>
</section>

<style>
  .studio {
    display: grid;
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 7vw, 96px);
  }
  .studio__text p:not(.stage) {
    max-width: 58ch;
    font-size: 1.08rem;
  }

  /* Character card */
  .studio__card {
    padding: 24px 24px 28px;
    background: var(--ink);
    color: var(--cream);
    border-radius: 16px;
    box-shadow: 10px 10px 0 var(--seal);
    rotate: -1.5deg;
  }
  .studio__p1 {
    margin: 0 0 16px;
    font-family: var(--f-arcade);
    font-size: 11px;
    color: var(--seal);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  /* Portrait framed like a character-select tile */
  .studio__avatar {
    aspect-ratio: 1;
    overflow: hidden;
    border: 3px solid var(--cream);
    border-radius: 10px;
  }
  .studio__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.4s ease;
  }
  .studio__card:hover .studio__avatar img {
    scale: 1.04;
  }
  .studio__buddy {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: -8px 0 18px;
    font-size: 14px;
    opacity: 0.85;
  }
  .studio__buddy img {
    width: 34px;
    height: auto;
  }
  .studio__name {
    margin: 18px 0 0;
    font-family: var(--f-display);
    font-size: 2.2rem;
    line-height: 1;
    text-transform: uppercase;
  }
  .studio__class {
    margin: 6px 0 18px;
    font-size: 14px;
    opacity: 0.7;
  }

  /* RPG-like stat bars (fill when the card scrolls into view) */
  .stats {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  .stat dt {
    margin-bottom: 6px;
    font-family: var(--f-arcade);
    font-size: 9px;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .stat dd {
    margin: 0;
  }
  .stat__bar {
    position: relative;
    display: block;
    height: 12px;
    background: var(--ink-3);
    border-radius: 3px;
    overflow: hidden;
  }
  .stat__bar::after {
    content: '';
    position: absolute;
    inset: 0;
    width: var(--v);
    background: repeating-linear-gradient(90deg, var(--seal) 0 10px, var(--seal-dark) 10px 12px);
    transition: width 1.2s cubic-bezier(0.3, 1.2, 0.5, 1) 0.2s;
  }
  :global(.js) .studio__card:not(.is-in) .stat__bar::after {
    width: 0;
  }

  .studio__kanji {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
    font-size: 14px !important;
    opacity: 0.75;
  }
  .studio__kanji [lang='ja'] {
    font-family: var(--f-kanji);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--seal);
  }

  @media (max-width: 820px) {
    .studio {
      grid-template-columns: minmax(0, 1fr);
    }
    .studio__card {
      max-width: 360px;
      width: 100%;
      margin-inline: auto;
      order: 2;
    }
  }
</style>
