---
// Arcade "attract screen": the monkey follows the pointer, clicking it inserts coins.
import Seal from './Seal.astro';
import { site } from '../data/site';
---
<section class="hero sec--ink" id="inicio">
  <div class="hero__kanji" aria-hidden="true">猿</div>
  <div class="hero__scanlines" aria-hidden="true"></div>

  <div class="hero__stage">
    <button class="mono" id="mono" type="button" aria-label="Dale al mono para insertar una moneda">
      <span class="mono__tilt" id="mono-tilt">
        <img
          class="mono__img"
          src="/brand/mono-negativo.svg"
          alt=""
          width="1480"
          height="1050"
          fetchpriority="high"
        />
        <span class="mono__shine" aria-hidden="true"></span>
      </span>
    </button>

    <h1 class="hero__title">
      <img src="/brand/rotulo-crema.svg" alt={site.name} width="1800" height="520" />
      <Seal class="hero__seal" />
    </h1>
    <p class="hero__tag">{site.tagline}</p>

    <a class="press-start" href="#juegos">
      <span class="press-start__arrow" aria-hidden="true">▶</span> Press start
    </a>
    <p class="hero__hint" aria-hidden="true">
      <span class="hero__hint--keys">↑ ↑ ↓ ↓ ← → ← → B A</span>
      <span class="hero__hint--touch">Toca al mono. Mucho.</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(100svh - var(--hud-h));
    padding: clamp(32px, 6vh, 72px) var(--gutter) clamp(48px, 8vh, 96px);
    overflow: hidden;
    isolation: isolate;
  }

  /* Giant brush kanji watermark behind everything */
  .hero__kanji {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: -2;
    translate: -50% -52%;
    font-family: var(--f-kanji);
    font-size: min(110vw, 92vh);
    line-height: 1;
    color: var(--cream);
    opacity: 0.035;
    user-select: none;
  }

  /* CRT scanlines + vignette */
  .hero__scanlines {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse at center, transparent 45%, rgba(0, 0, 0, 0.55) 100%),
      repeating-linear-gradient(to bottom, rgba(244, 239, 230, 0.035) 0 1px, transparent 1px 4px);
  }

  .hero__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ---------- The monkey ---------- */

  .mono {
    display: block;
    width: min(78vw, 480px, 52vh);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    perspective: 900px;
    -webkit-tap-highlight-color: transparent;
  }
  .mono:focus-visible {
    outline-offset: 12px;
    border-radius: 24px;
  }
  .mono__tilt {
    position: relative;
    display: block;
    transform-style: preserve-3d;
    will-change: transform;
    animation: idle-bob 4s ease-in-out infinite;
  }
  .mono__img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 0 rgba(0, 0, 0, 0.35));
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Red light sweep that only shows on the ink lines (masked by the logo itself) */
  .mono__shine {
    position: absolute;
    inset: 0;
    -webkit-mask: url('/brand/mono-negativo.svg') center / contain no-repeat;
    mask: url('/brand/mono-negativo.svg') center / contain no-repeat;
    background: linear-gradient(
      105deg,
      transparent 42%,
      rgba(200, 52, 43, 0.95) 49%,
      rgba(244, 239, 230, 0.9) 50%,
      rgba(200, 52, 43, 0.95) 51%,
      transparent 58%
    );
    background-size: 300% 100%;
    background-position: 120% 0;
    animation: shine 5.5s ease-in-out 1.2s infinite;
    pointer-events: none;
  }

  /* Bounce when a coin is inserted (class toggled from JS) */
  :global(.mono.is-hit) .mono__img {
    animation: hit 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  @keyframes idle-bob {
    50% {
      translate: 0 -8px;
    }
  }
  @keyframes shine {
    0%,
    55% {
      background-position: 120% 0;
    }
    85%,
    100% {
      background-position: -20% 0;
    }
  }
  @keyframes hit {
    40% {
      scale: 1.08 0.9;
    }
    100% {
      scale: 1;
    }
  }

  /* ---------- Wordmark + seal (same proportions as the vertical logo) ---------- */

  .hero__title {
    display: flex;
    align-items: flex-start;
    gap: 2.4%;
    width: min(84vw, 560px);
    margin: clamp(12px, 3vh, 28px) 0 0;
  }
  .hero__title img {
    flex: 1;
    min-width: 0;
    height: auto;
  }
  .hero__title :global(.hero__seal) {
    width: 17.4%;
    height: auto;
    margin-top: -2.5%;
  }

  .hero__tag {
    margin: 14px 0 0;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* ---------- PRESS START ---------- */

  .press-start {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: clamp(24px, 5vh, 48px);
    padding: 14px 18px;
    font-family: var(--f-arcade);
    font-size: clamp(13px, 2.4vw, 18px);
    color: var(--seal);
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 8px;
    animation: blink 1.1s steps(1) infinite;
  }
  .press-start:hover,
  .press-start:focus-visible {
    animation: none;
    color: var(--cream);
    background: var(--seal);
  }
  .press-start__arrow {
    font-size: 0.8em;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero__hint {
    margin: 18px 0 0;
    /* Body font: the pixel font has no arrow glyphs */
    font-family: var(--f-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.25em;
    opacity: 0.35;
  }
  .hero__hint--touch {
    display: none;
  }
  @media (hover: none) {
    .hero__hint--keys {
      display: none;
    }
    .hero__hint--touch {
      display: inline;
    }
  }
</style>
