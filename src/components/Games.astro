---
// "Elige tu juego": each game is an ink-printed cartridge. Data lives in src/data/games.ts.
import { games, archive } from '../data/games';
import { useT, type Lang } from '../i18n/ui';
import HikariArt from './HikariArt.astro';

interface Props {
  /** Page language. */
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang).games;

// The pixel font has no uppercase accented glyphs, so strip accents for arcade labels.
const plain = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '');
---
<section class="sec sec--cream" id="juegos" aria-labelledby="juegos-title">
  <div class="wrap">
    <p class="stage">Stage 01</p>
    <h2 class="title" id="juegos-title">{t.title}</h2>
    <p class="lead">{t.lead}</p>

    <ul class="carts">
      {games.map((game, i) => (
        <li class:list={['cart', { 'cart--locked': game.locked, 'cart--featured': game.featured }]}>
          <div class="cart__grip" aria-hidden="true"></div>
          <div class="cart__label">
            <div class="cart__cover">
              {game.art === 'hikari' ? (
                <HikariArt />
              ) : game.cover ? (
                <img src={game.cover} alt="" loading="lazy" />
              ) : (
                <span class="cart__placeholder" aria-hidden="true">{game.locked ? '?' : '猿'}</span>
              )}
              <span class="cart__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="cart__body">
              <div class="cart__tags">
                {game.featured && <p class="cart__star"><span class="cart__star-icon" aria-hidden="true">★</span> {t.featured}</p>}
                <p class:list={['cart__status', `cart__status--${game.status}`]}>{plain(t.status[game.status])}</p>
              </div>
              <h3 class="cart__title">{game.locked ? <span aria-label={t.secret}>???</span> : game.title}</h3>
              <p class="cart__blurb">{game.blurb[lang]}</p>
              {game.platforms && game.platforms.length > 0 && (
                <ul class="cart__platforms">
                  {game.platforms.map((p) => <li>{p}</li>)}
                </ul>
              )}
              {game.link && (
                <a class="btn cart__cta" href={game.link.href}>{game.link.label[lang]}</a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>

    {archive.length > 0 && (
      <div class="archive">
        <h3 class="archive__title">{t.archiveTitle}</h3>
        <p class="archive__lead">{t.archiveLead}</p>
        <ol class="board">
          {archive.map((g, i) => (
            <li>
              <a class="board__row" href={g.href} target="_blank" rel="noopener">
                <span class="board__rank" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="board__name">{g.title}</span>
                {g.genre && <span class="board__genre">{plain(g.genre[lang])}</span>}
                <span class="board__play">{t.play} <span class="sr-only">{t.opensItch}</span><span aria-hidden="true">▶</span></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    )}
  </div>
</section>

<style>
  .carts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(24px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Cartridge shell: thick ink outline + hard offset shadow, like a print */
  .cart {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0 14px 14px;
    background: var(--ink);
    border-radius: 18px 18px 8px 8px;
    box-shadow: 8px 8px 0 var(--seal);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .cart:hover {
    transform: translate(-4px, -6px) rotate(-0.6deg);
    box-shadow: 12px 14px 0 var(--seal);
  }
  .cart--locked {
    box-shadow: 8px 8px 0 var(--cream-3);
  }
  .cart--locked:hover {
    box-shadow: 12px 14px 0 var(--cream-3);
  }

  /* Ridges on top of the cartridge */
  .cart__grip {
    height: 26px;
    margin-inline: 18%;
    background: repeating-linear-gradient(90deg, var(--ink-3) 0 6px, transparent 6px 14px);
    border-radius: 0 0 4px 4px;
  }

  .cart__label {
    display: flex;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    background: var(--cream);
    border-radius: 6px;
  }

  .cart__cover {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--ink-2) var(--grain-dark);
    border-bottom: 3px solid var(--ink);
  }
  .cart__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart__placeholder {
    font-family: var(--f-kanji);
    font-size: clamp(64px, 9vw, 96px);
    line-height: 1;
    color: var(--cream);
    opacity: 0.85;
  }
  .cart--locked .cart__placeholder {
    font-family: var(--f-arcade);
    color: var(--ink-3);
    opacity: 1;
    animation: float-q 2.4s ease-in-out infinite;
  }
  @keyframes float-q {
    50% {
      translate: 0 -6px;
    }
  }
  .cart__num {
    position: absolute;
    top: 10px;
    left: 10px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: var(--seal);
    color: var(--cream);
    font-family: var(--f-arcade);
    font-size: 11px;
    border-radius: 6px;
    rotate: -7deg;
  }

  .cart__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 18px 18px 20px;
    color: var(--ink);
  }
  .cart__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cart__star {
    margin: 0;
    padding: 6px 8px;
    border: 2px solid var(--seal);
    border-radius: 4px;
    background: var(--seal);
    color: var(--cream);
    font-family: var(--f-arcade);
    font-size: 9px;
    line-height: 1;
    text-transform: uppercase;
  }
  /* The pixel font has no star glyph */
  .cart__star-icon {
    font-family: var(--f-body);
    font-size: 11px;
  }
  .cart__status {
    margin: 0;
    padding: 6px 8px;
    border: 2px solid currentColor;
    border-radius: 4px;
    font-family: var(--f-arcade);
    font-size: 9px;
    line-height: 1;
    text-transform: uppercase;
  }
  .cart__status--en-desarrollo {
    color: var(--seal);
  }
  .cart__status--disponible {
    color: var(--cream);
    background: var(--seal);
    border-color: var(--seal);
  }
  .cart__title {
    margin: 4px 0 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .cart__blurb {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    opacity: 0.8;
  }
  .cart__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }
  .cart__platforms li {
    padding: 2px 8px;
    background: var(--cream-2);
    border-radius: 4px;
  }
  .cart__cta {
    align-self: flex-start;
    margin-top: auto;
  }

  /* ---------- Archive: arcade high-score board ---------- */

  .archive {
    margin-top: clamp(56px, 8vw, 96px);
    padding: clamp(24px, 4vw, 40px);
    background: var(--ink) var(--grain-dark);
    color: var(--cream);
    border-radius: 16px;
    box-shadow: 10px 10px 0 var(--seal);
  }
  .archive__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .archive__lead {
    margin: 8px 0 24px;
    font-size: 15px;
    opacity: 0.7;
  }
  .board {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px dashed var(--ink-3);
  }
  .board li {
    border-bottom: 2px dashed var(--ink-3);
  }
  .board__row {
    display: grid;
    grid-template-columns: 3.2em 1fr auto auto;
    align-items: center;
    gap: 16px;
    padding: 14px 8px;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .board__row:hover,
  .board__row:focus-visible {
    background: var(--cream);
    color: var(--ink);
  }
  .board__rank,
  .board__genre,
  .board__play {
    font-family: var(--f-arcade);
    font-size: 10px;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .board__rank,
  .board__play {
    color: var(--seal);
  }
  .board__name {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .board__genre {
    opacity: 0.6;
  }
  @media (max-width: 560px) {
    .board__row {
      grid-template-columns: 2.6em 1fr auto;
    }
    .board__genre {
      display: none;
    }
  }

  /* Flagship game: spans the whole row, cover beside the text on wide screens */
  .cart--featured {
    grid-column: 1 / -1;
  }
  .cart--featured .cart__title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }
  @media (min-width: 760px) {
    .cart--featured .cart__label {
      flex-direction: row;
    }
    .cart--featured .cart__cover {
      flex: 1.3;
      border-bottom: 0;
      border-right: 3px solid var(--ink);
    }
    .cart--featured .cart__body {
      flex: 1;
      justify-content: center;
      padding: 32px;
    }
    .cart--featured .cart__blurb {
      font-size: 17px;
    }
  }
</style>
