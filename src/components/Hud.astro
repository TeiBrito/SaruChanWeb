---
// Sticky arcade HUD: score (grows as you explore), navigation, language switch, hi-score and credits.
import Seal from './Seal.astro';
import { getNav } from '../data/site';
import { languages, localePath, useT, type Lang } from '../i18n/ui';

interface Props {
  /** Page language. */
  lang: Lang;
  /** URL of this same page in the other language (falls back to its home). */
  altHref?: string;
}
const { lang, altHref } = Astro.props;
const t = useT(lang);
const nav = getNav(lang);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const otherHref = altHref ?? localePath(otherLang, '/');
---
<header class="hud">
  <div class="hud__inner">
    <div class="hud__left">
      <a class="hud__home" href={localePath(lang, '/')} aria-label={t.hud.home}>
        <Seal class="hud__seal" />
      </a>
      <p class="hud__stat" aria-hidden="true">
        <span class="hud__label">1UP</span>
        <span class="hud__value" id="hud-score">000000</span>
      </p>
    </div>

    <nav class="hud__nav" aria-label={t.nav.label}>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hud__right">
      <p class="hud__stat hud__stat--hi" aria-hidden="true">
        <span class="hud__label">HI</span>
        <span class="hud__value" id="hud-hi">000000</span>
      </p>
      <p class="hud__stat" aria-hidden="true">
        <span class="hud__label">CREDIT</span>
        <span class="hud__value" id="hud-credit">00</span>
      </p>
      <!-- Language switch: current language highlighted, the other one is a link -->
      <div class="lang" role="group" aria-label={t.langSwitch.label}>
        {(Object.keys(languages) as Lang[]).map((code) =>
          code === lang ? (
            <span class="lang__opt is-current" aria-current="true" lang={code}>{code.toUpperCase()}</span>
          ) : (
            <a class="lang__opt" href={otherHref} hreflang={code} lang={code} title={t.langSwitch.other}>
              {code.toUpperCase()}
            </a>
          ),
        )}
      </div>
    </div>
  </div>
</header>

<style>
  .hud {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(22, 19, 15, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 2px solid var(--ink-3);
    font-family: var(--f-arcade);
    font-size: 10px;
    line-height: 1;
    color: var(--cream);
  }
  .hud__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    max-width: var(--max);
    min-height: var(--hud-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .hud__left,
  .hud__right {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .hud__right {
    justify-content: flex-end;
  }
  .hud__home {
    display: block;
    border-radius: 6px;
  }
  .hud__home :global(.hud__seal) {
    width: 34px;
    height: 34px;
    transition: transform 0.2s ease;
  }
  .hud__home:hover :global(.hud__seal) {
    transform: rotate(5deg) scale(1.08);
  }
  .hud__stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
  }
  .hud__label {
    color: var(--seal);
  }
  .hud__value {
    font-variant-numeric: tabular-nums;
  }
  .hud__nav ul {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hud__nav a {
    display: block;
    padding: 10px 12px;
    border-radius: 6px;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .hud__nav a:hover {
    background: var(--cream);
    color: var(--ink);
  }
  /* Arcade "selector" arrow on hover */
  .hud__nav a::before {
    content: '▶';
    display: inline-block;
    width: 0;
    overflow: hidden;
    color: var(--seal);
    vertical-align: top;
    transition: width 0.15s ease;
  }
  .hud__nav a:hover::before {
    width: 1.4em;
  }

  /* ---------- Language switch ---------- */
  .lang {
    display: flex;
    border: 2px solid var(--ink-3);
    border-radius: 6px;
    overflow: hidden;
  }
  .lang__opt {
    padding: 7px 7px 6px;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .lang__opt.is-current {
    background: var(--seal);
    color: var(--cream);
  }
  a.lang__opt:hover {
    background: var(--cream);
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .hud__inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'left right'
        'nav nav';
      row-gap: 0;
      padding-top: 10px;
    }
    .hud__left {
      grid-area: left;
    }
    .hud__right {
      grid-area: right;
    }
    .hud__nav {
      grid-area: nav;
      margin-inline: calc(var(--gutter) * -1);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .hud__nav ul {
      justify-content: space-between;
      min-width: max-content;
      padding-inline: calc(var(--gutter) - 12px);
    }
    .hud__nav a {
      padding: 12px;
    }
  }
  @media (max-width: 420px) {
    .hud {
      font-size: 9px;
    }
    .hud__left,
    .hud__right {
      gap: 12px;
    }
    /* Make room for the language switch on small phones */
    .hud__stat--hi {
      display: none;
    }
  }
</style>
