---
// Contact and social links.
import Seal from './Seal.astro';
import { site } from '../data/site';
import { useT, type Lang } from '../i18n/ui';

interface Props {
  /** Page language. */
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang).contact;
---
<section class="sec sec--ink contact" id="contacto" aria-labelledby="contacto-title">
  <div class="wrap contact__inner">
    <Seal class="contact__seal" />
    <p class="stage">Stage 04</p>
    <h2 class="title" id="contacto-title">{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <a class="btn contact__mail" href={`mailto:${site.email}`}>{site.email}</a>

    <ul class="socials" aria-label={t.socials}>
      {site.socials.map((s) => (
        <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact__inner {
    position: relative;
  }
  /* Big tilted seal stamped on the right, like a signature */
  .contact :global(.contact__seal) {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    width: clamp(120px, 20vw, 220px);
    height: auto;
    translate: 0 -50%;
    rotate: 6deg;
  }
  .contact__mail {
    max-width: 100%;
    font-size: clamp(10px, 2.6vw, 13px);
    text-transform: none;
    overflow-wrap: anywhere;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .socials a {
    display: inline-block;
    padding: 9px 14px;
    border: 2px solid var(--ink-3);
    border-radius: 999px;
    font-size: 14px;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .socials a:hover {
    border-color: var(--seal);
    color: var(--seal);
  }

  @media (max-width: 820px) {
    .contact :global(.contact__seal) {
      position: static;
      width: 72px;
      margin-bottom: 20px;
      translate: none;
      rotate: -7deg;
    }
  }
</style>
