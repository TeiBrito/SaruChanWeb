---
// Full home page, shared by every language (/ and /en/).
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Brush from './Brush.astro';
import Games from './Games.astro';
import Devlog from './Devlog.astro';
import Studio from './Studio.astro';
import Contact from './Contact.astro';
import { localePath, type Lang } from '../i18n/ui';

interface Props {
  /** Page language. */
  lang: Lang;
}
const { lang } = Astro.props;
const altPath = localePath(lang === 'es' ? 'en' : 'es', '/');
---
<Base lang={lang} altPath={altPath}>
  <Hero lang={lang} />
  <Brush from="var(--ink)" to="var(--cream)" />
  <Games lang={lang} />
  <Brush from="var(--cream)" to="var(--ink)" mirror />
  <Devlog lang={lang} />
  <Brush from="var(--ink)" to="var(--cream)" />
  <Studio lang={lang} />
  <Brush from="var(--cream)" to="var(--ink)" mirror />
  <Contact lang={lang} />
</Base>
