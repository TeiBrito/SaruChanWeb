---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Brush from '../components/Brush.astro';
import Games from '../components/Games.astro';
import Devlog from '../components/Devlog.astro';
import Studio from '../components/Studio.astro';
import Contact from '../components/Contact.astro';
---
<Base>
  <Hero />
  <Brush from="var(--ink)" to="var(--cream)" />
  <Games />
  <Brush from="var(--cream)" to="var(--ink)" mirror />
  <Devlog />
  <Brush from="var(--ink)" to="var(--cream)" />
  <Studio />
  <Brush from="var(--cream)" to="var(--ink)" mirror />
  <Contact />
</Base>
